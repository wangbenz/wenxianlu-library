{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenxian.local/schema/realm.json",
  "type": "object",
  "properties": {
    "type": {
      "const": "realm"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "[㐀-鿿]"
    },
    "phase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "public": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "usage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "limitations": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "source": {
          "type": "string",
          "enum": [
            "通用修仙设定",
            "问仙录原创设定"
          ]
        }
      },
      "required": [
        "description",
        "usage",
        "limitations"
      ],
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "detail": {
          "type": "string",
          "enum": [
            "full",
            "placeholder"
          ]
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "key",
              "name"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 13,
          "uniqueItems": true
        },
        "lifespan_years": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "can": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sense_qi",
              "absorb_qi",
              "basic_spell",
              "use_low_artifact",
              "use_mid_artifact",
              "use_high_artifact",
              "weapon_flight",
              "spiritual_sense",
              "extended_fasting",
              "core_formation",
              "nascent_soul",
              "ascension",
              "mundane_labor",
              "short_rest",
              "ordinary_weapon",
              "flight"
            ]
          },
          "minItems": 0,
          "maxItems": 30,
          "uniqueItems": true
        },
        "cannot": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sense_qi",
              "absorb_qi",
              "basic_spell",
              "use_low_artifact",
              "use_mid_artifact",
              "use_high_artifact",
              "weapon_flight",
              "spiritual_sense",
              "extended_fasting",
              "core_formation",
              "nascent_soul",
              "ascension",
              "mundane_labor",
              "short_rest",
              "ordinary_weapon",
              "flight"
            ]
          },
          "minItems": 0,
          "maxItems": 30,
          "uniqueItems": true
        },
        "breakthrough": {
          "type": "object",
          "properties": {
            "requires": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "has_root",
                  "learned_entry_art",
                  "first_qi_absorption",
                  "previous_realm_complete",
                  "has_breakthrough_method",
                  "resources_prepared"
                ]
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            },
            "aids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:item):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "minItems": 0,
              "maxItems": 100,
              "uniqueItems": true
            },
            "risk": {
              "type": "object",
              "properties": {
                "outcome": {
                  "type": "string",
                  "enum": [
                    "fatigue",
                    "qi_backlash",
                    "meridian_strain",
                    "cultivation_stall"
                  ]
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "minor",
                    "moderate",
                    "severe"
                  ]
                },
                "recoverable": {
                  "type": "boolean"
                }
              },
              "required": [
                "outcome",
                "severity",
                "recoverable"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "requires",
            "aids",
            "risk"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "order",
        "detail",
        "stages",
        "lifespan_years",
        "can",
        "cannot"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "detail": {
                "const": "full"
              }
            }
          },
          "then": {
            "properties": {
              "can": {
                "minItems": 1
              },
              "cannot": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "narration": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "secret": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "key",
    "name",
    "phase",
    "public",
    "rules",
    "narration",
    "secret"
  ],
  "additionalProperties": false
}
