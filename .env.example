# Values must be supplied as process environment variables; .env is not auto-loaded.
# Library settings: server.settings.
WENXIANLU_DEBUG=True
# Optional; defaults to this independent database. Never use db.sqlite3 here.
# WENXIANLU_DB_PATH=var/wenxianlu-library.sqlite3
# Optional; defaults to var/staticfiles. Use a temporary path for isolated checks.
# WENXIANLU_STATIC_ROOT=var/staticfiles
# Non-debug mode requires your own random SECRET_KEY; never commit its value.
# SECRET_KEY=
