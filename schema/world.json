{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenxian.local/schema/world.json",
  "type": "object",
  "properties": {
    "type": {
      "const": "world"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "[㐀-鿿]"
    },
    "phase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "public": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "source": {
          "type": "string",
          "enum": [
            "通用修仙设定",
            "问仙录原创设定"
          ]
        }
      },
      "required": [
        "description"
      ],
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "properties": {
        "layers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "lower",
              "upper"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:region):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "layers",
        "regions"
      ],
      "additionalProperties": false
    },
    "narration": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "secret": {
      "type": "object",
      "properties": {
        "long_term_truth": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "key",
    "name",
    "phase",
    "public",
    "rules",
    "narration",
    "secret"
  ],
  "additionalProperties": false
}
