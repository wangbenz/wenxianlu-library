{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenxian.local/schema/faction.json",
  "type": "object",
  "properties": {
    "type": {
      "const": "faction"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "[㐀-鿿]"
    },
    "phase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "public": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "source": {
          "type": "string",
          "enum": [
            "通用修仙设定",
            "问仙录原创设定"
          ]
        }
      },
      "required": [
        "description"
      ],
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "sect",
            "clan",
            "guild",
            "rogue"
          ]
        },
        "alignment": {
          "type": "string",
          "enum": [
            "righteous",
            "demonic",
            "neutral"
          ]
        },
        "seat": {
          "type": "string",
          "pattern": "^(?:place):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "strongest_realm": {
          "type": "string",
          "pattern": "^(?:realm):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "recruit": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "roots": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:root):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                },
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true
              },
              "rank": {
                "type": "string",
                "enum": [
                  "inner",
                  "outer",
                  "servant",
                  "reject"
                ]
              }
            },
            "required": [
              "roots",
              "rank"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "ranks": {
          "type": "object",
          "properties": {
            "inner": {
              "type": "object",
              "properties": {
                "monthly": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "item": {
                        "type": "string",
                        "pattern": "^(?:item):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000
                      }
                    },
                    "required": [
                      "item",
                      "quantity"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "maxItems": 100,
                  "uniqueItems": true
                },
                "duties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "monthly",
                "duties"
              ],
              "additionalProperties": false
            },
            "outer": {
              "type": "object",
              "properties": {
                "monthly": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "item": {
                        "type": "string",
                        "pattern": "^(?:item):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000
                      }
                    },
                    "required": [
                      "item",
                      "quantity"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "maxItems": 100,
                  "uniqueItems": true
                },
                "duties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "monthly",
                "duties"
              ],
              "additionalProperties": false
            },
            "servant": {
              "type": "object",
              "properties": {
                "monthly": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "item": {
                        "type": "string",
                        "pattern": "^(?:item):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000
                      }
                    },
                    "required": [
                      "item",
                      "quantity"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "maxItems": 100,
                  "uniqueItems": true
                },
                "duties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "monthly",
                "duties"
              ],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "arts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:art):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "specialties": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:item):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:character):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "visit_weight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "kind",
        "seat",
        "strongest_realm",
        "recruit",
        "ranks",
        "arts",
        "specialties",
        "characters"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sect"
              }
            }
          },
          "then": {
            "required": [
              "visit_weight"
            ]
          },
          "else": {
            "not": {
              "required": [
                "visit_weight"
              ]
            }
          }
        }
      ]
    },
    "narration": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "secret": {
      "type": "object",
      "properties": {
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "key",
    "name",
    "phase",
    "public",
    "rules",
    "narration",
    "secret"
  ],
  "additionalProperties": false
}
