{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenxian.local/schema/place.json",
  "type": "object",
  "properties": {
    "type": {
      "const": "place"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "[㐀-鿿]"
    },
    "phase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "public": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "source": {
          "type": "string",
          "enum": [
            "通用修仙设定",
            "问仙录原创设定"
          ]
        }
      },
      "required": [
        "description"
      ],
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "country",
            "mountain",
            "sea",
            "county",
            "town",
            "market",
            "sect_gate",
            "wild",
            "secret_realm",
            "building"
          ]
        },
        "parent": {
          "type": "string",
          "pattern": "^(?:place|region):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "danger": {
          "type": "string",
          "enum": [
            "safe",
            "low",
            "medium",
            "high",
            "deadly"
          ]
        },
        "max_rarity": {
          "type": "string",
          "enum": [
            "common",
            "uncommon",
            "rare",
            "precious"
          ]
        },
        "realm_range": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:realm):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "products": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:item):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "factions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:faction):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "parent",
        "danger",
        "max_rarity",
        "realm_range",
        "products",
        "factions"
      ],
      "additionalProperties": false
    },
    "narration": {
      "type": "object",
      "properties": {
        "atmosphere": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "secret": {
      "type": "object",
      "properties": {
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "key",
    "name",
    "phase",
    "public",
    "rules",
    "narration",
    "secret"
  ],
  "additionalProperties": false
}
