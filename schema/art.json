{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenxian.local/schema/art.json",
  "type": "object",
  "properties": {
    "type": {
      "const": "art"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "[㐀-鿿]"
    },
    "phase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "public": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "usage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "limitations": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "source": {
          "type": "string",
          "enum": [
            "通用修仙设定",
            "问仙录原创设定"
          ]
        }
      },
      "required": [
        "description",
        "usage",
        "limitations"
      ],
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "practice",
            "spell"
          ]
        },
        "grade": {
          "type": "string",
          "enum": [
            "huang_low",
            "huang_mid",
            "huang_high",
            "xuan_low",
            "xuan_mid",
            "xuan_high",
            "di_low",
            "di_mid",
            "di_high",
            "tian_low",
            "tian_mid",
            "tian_high"
          ]
        },
        "realm": {
          "type": "string",
          "pattern": "^(?:realm):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "max_realm": {
          "type": "string",
          "pattern": "^(?:realm):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "affinity": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "metal",
              "wood",
              "water",
              "fire",
              "earth",
              "wind",
              "thunder",
              "ice"
            ]
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "effect": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "cultivation_boost",
                "breakthrough_aid",
                "heal",
                "restore_spirit",
                "sustenance",
                "protect",
                "attack",
                "movement",
                "storage",
                "utility",
                "material",
                "currency"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "type",
            "note"
          ],
          "additionalProperties": false
        },
        "obtain": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "market",
              "sect",
              "gather",
              "craft",
              "monster",
              "secret_realm",
              "reward"
            ]
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "grade",
        "realm",
        "affinity",
        "effect",
        "obtain"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "practice"
              }
            }
          },
          "then": {
            "required": [
              "max_realm"
            ]
          },
          "else": {
            "not": {
              "required": [
                "max_realm"
              ]
            }
          }
        }
      ]
    },
    "narration": {
      "type": "object",
      "properties": {
        "casting": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "secret": {
      "type": "object",
      "properties": {
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "key",
    "name",
    "phase",
    "public",
    "rules",
    "narration",
    "secret"
  ],
  "additionalProperties": false
}
